#!/usr/bin/env python3
"""mesh — tiny CLI for an installed agent-mesh agent.

Reads ~/.config/agent-mesh/config.json (written by install.sh) and talks to
the orchestrator. Stdlib-only.

Usage:
  mesh status                 # health + who am I
  mesh checkin                # heartbeat
  mesh pull                   # claim next task (prints JSON, or 'none')
  mesh start <task_id>
  mesh progress <task_id> [--pct N] [--note TEXT]
  mesh result <task_id> --status ok|failed|partial [--output JSON] [--error MSG]
  mesh upload <task_id> <path>
  mesh tasks [--status S]     # list tasks
  mesh events [--task-id T]   # recent events
  mesh peers                  # who's in the swarm + presence
  mesh worker                 # run the poll/execute/report loop (daemon)

Worker loop:
  mesh worker [--poll 30] [--heartbeat 60] [--once] [--dry-run]
    --poll N       seconds between pulls when idle (default 30)
    --heartbeat N  seconds between presence heartbeats (default 60; keep < 90)
    --once         single tick then exit (for cron/timer use)
    --dry-run      pull+report but don't execute (prints the task spec)
"""
import argparse
import json
import os
import signal
import subprocess
import sys
import time
import urllib.request
import urllib.error

CFG = os.path.expanduser("~/.config/agent-mesh/config.json")


def load_cfg():
    if not os.path.exists(CFG):
        sys.exit("no config at %s — run ./install.sh first" % CFG)
    with open(CFG) as f:
        return json.load(f)


def call(cfg, method, path, body=None, _exit=True, extra_headers=None):
    url = cfg["base_url"].rstrip("/") + path
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", "Bearer " + cfg["api_key"])
    if extra_headers:
        for k, v in extra_headers.items():
            req.add_header(k, v)
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        try:
            d = json.loads(e.read().decode())
        except Exception:
            d = {"detail": str(e)}
        msg = "%s %s -> HTTP %s: %s" % (method, path, e.code, d.get("detail", d))
        if _exit:
            sys.exit(msg)
        raise RuntimeError(msg)
    except Exception as e:  # network errors etc.
        if _exit:
            sys.exit("%s %s -> %s" % (method, path, e))
        raise


def main():
    ap = argparse.ArgumentParser(prog="mesh", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status")
    sub.add_parser("checkin")
    sub.add_parser("pull")
    p = sub.add_parser("start"); p.add_argument("task_id")
    p = sub.add_parser("progress"); p.add_argument("task_id")
    p.add_argument("--pct", type=float); p.add_argument("--note")
    p = sub.add_parser("result"); p.add_argument("task_id")
    p.add_argument("--status", required=True, choices=["ok", "failed", "partial"])
    p.add_argument("--output"); p.add_argument("--error")
    p = sub.add_parser("upload"); p.add_argument("task_id"); p.add_argument("path")
    p = sub.add_parser("tasks"); p.add_argument("--status")
    p = sub.add_parser("events"); p.add_argument("--task-id")
    p = sub.add_parser("peers")
    p = sub.add_parser("msg", help="send an A2A message to another agent")
    p.add_argument("to", help="target agent id or name")
    p.add_argument("text", nargs="?", help="message text")
    p.add_argument("--type", default="note",
                   help="note|task.dispatch|task.result|ping (default note)")
    p.add_argument("--payload", help="raw JSON payload (overrides --text)")
    p.add_argument("--correlation-id"); p.add_argument("--reply-to")
    p = sub.add_parser("inbox", help="read your A2A inbox (over the mesh)")
    p.add_argument("--limit", type=int, default=50)
    p.add_argument("--unread", action="store_true", help="only unread")
    p.add_argument("--mark-read", action="store_true", help="mark returned as read")
    p = sub.add_parser("listen", help="long-poll for incoming messages (near-push)")
    p.add_argument("--timeout", type=float, default=25, help="seconds to hold each poll (<=55)")
    p.add_argument("--once", action="store_true", help="single poll then exit")
    p.add_argument("--mark-read", action="store_true", help="auto-mark received as read")
    p = sub.add_parser("worker", help="run the poll/execute/report loop")
    p.add_argument("--poll", type=float, default=30, help="idle seconds between pulls")
    p.add_argument("--heartbeat", type=float, default=60, help="seconds between presence heartbeats (<90)")
    p.add_argument("--once", action="store_true", help="single tick then exit (cron use)")
    p.add_argument("--dry-run", action="store_true", help="pull+report but don't execute")
    args = ap.parse_args()
    cfg = load_cfg()

    if args.cmd == "status":
        print("orchestrator:", cfg["base_url"])
        print("agent       :", cfg["agent_id"])
        me = call(cfg, "GET", "/api/agents/me")
        print("role        :", me["role"], "| status:", me["status"])
    elif args.cmd == "checkin":
        print(json.dumps(call(cfg, "POST", "/api/agents/checkin", {})))
    elif args.cmd == "pull":
        d = call(cfg, "GET", "/api/work/pull")
        print(json.dumps(d["task"], indent=2) if d.get("task") else "none")
    elif args.cmd == "start":
        print(json.dumps(call(cfg, "POST", f"/api/tasks/{args.task_id}/start", {})))
    elif args.cmd == "progress":
        body = {}
        if args.pct is not None:
            body["pct"] = args.pct
        if args.note:
            body["note"] = args.note
        print(json.dumps(call(cfg, "POST", f"/api/tasks/{args.task_id}/progress", body)))
    elif args.cmd == "result":
        body = {"status": args.status}
        if args.output:
            body["output"] = json.loads(args.output)
        if args.error:
            body["error"] = args.error
        print(json.dumps(call(cfg, "POST", f"/api/tasks/{args.task_id}/result", body), indent=2))
    elif args.cmd == "upload":
        # multipart upload
        import secrets
        boundary = "----mesh" + secrets.token_hex(8)
        with open(args.path, "rb") as f:
            file_bytes = f.read()
        fname = os.path.basename(args.path)
        body = (f"--{boundary}\r\nContent-Disposition: form-data; name=\"task_id\"\r\n\r\n"
                f"{args.task_id}\r\n--{boundary}\r\nContent-Disposition: form-data; "
                f"name=\"file\"; filename=\"{fname}\"\r\n"
                f"Content-Type: application/octet-stream\r\n\r\n").encode() \
            + file_bytes + f"\r\n--{boundary}--\r\n".encode()
        req = urllib.request.Request(cfg["base_url"].rstrip("/") + "/api/artifacts",
                                     data=body, method="POST")
        req.add_header("Authorization", "Bearer " + cfg["api_key"])
        req.add_header("Content-Type", f"multipart/form-data; boundary={boundary}")
        with urllib.request.urlopen(req, timeout=60) as r:
            print(json.dumps(json.loads(r.read().decode()), indent=2))
    elif args.cmd == "tasks":
        q = f"?status={args.status}" if args.status else ""
        print(json.dumps(call(cfg, "GET", "/api/tasks" + q), indent=2))
    elif args.cmd == "events":
        q = f"?task_id={args.task_id}" if args.task_id else ""
        print(json.dumps(call(cfg, "GET", "/api/events" + q), indent=2))
    elif args.cmd == "peers":
        d = call(cfg, "GET", "/api/agents")
        me = cfg["agent_id"]
        for a in d["items"]:
            mark = " (you)" if a["id"] == me else ""
            print(f'{a["status"]:9}  {a["role"]:13}  {a["name"]}{mark}  '
                  f'[{a["id"]}]')
    elif args.cmd == "msg":
        body = {"to": args.to, "type": args.type}
        if args.payload:
            body["payload"] = json.loads(args.payload)
        else:
            body["payload"] = {"text": args.text or ""}
        if args.correlation_id:
            body["correlation_id"] = args.correlation_id
        if args.reply_to:
            body["reply_to"] = args.reply_to
        print(json.dumps(call(cfg, "POST", "/api/messages", body), indent=2))
    elif args.cmd == "inbox":
        q = f"?limit={args.limit}"
        hdrs = {"X-Read": "unread"} if args.unread else None
        d = call(cfg, "GET", "/api/messages" + q, extra_headers=hdrs)
        print(f'unread: {d["unread"]}')
        for m in d["items"]:
            p = m.get("payload", {})
            text = p.get("text", json.dumps(p)) if isinstance(p, dict) else str(p)
            flag = "• " if m["status"] == "unread" else "  "
            print(f'{flag}{m["from"]:24} [{m["type"]:13}] {text[:80]}  ({m["id"]})')
            if args.mark_read and m["status"] == "unread":
                call(cfg, "POST", f"/api/messages/{m['id']}/read", {})
    elif args.cmd == "listen":
        # Long-poll loop: drains any backlog (last_id=0), then holds a
        # connection and prints each NEW message as it lands (~1s latency).
        last_id = 0
        try:
            while True:
                d = call(cfg, "GET",
                         f"/api/messages/stream?last_id={last_id}&timeout={args.timeout}",
                         _exit=False)
                for m in d.get("items", []):
                    p = m.get("payload", {})
                    text = p.get("text", json.dumps(p)) if isinstance(p, dict) else str(p)
                    print(f'{m["from"]:24} [{m["type"]:13}] {text}  ({m["id"]})', flush=True)
                    if args.mark_read:
                        call(cfg, "POST", f"/api/messages/{m['id']}/read", {}, _exit=False)
                last_id = d.get("last_id", last_id)  # integer rowid cursor
                if args.once:
                    break
        except KeyboardInterrupt:
            print("\n(listen stopped)")
    elif args.cmd == "worker":
        run_worker(cfg, poll=args.poll, heartbeat=args.heartbeat,
                   once=args.once, dry_run=args.dry_run)


def execute_task(cfg, task):
    """Execute a claimed task. Default: run spec.command if present, else no-op.
    Returns (status, output_dict). Override by editing this function or by
    pointing MESH_WORKER_CMD at your own executor script (argv: <task_json>)."""
    spec = task.get("spec") or {}
    cmd = spec.get("command")
    custom = os.environ.get("MESH_WORKER_CMD")
    if custom:
        # external executor: pass the full task JSON on stdin; exit 0 => ok
        r = subprocess.run([custom], input=json.dumps(task).encode(),
                           capture_output=True, timeout=3600)
        out = {"stdout": r.stdout.decode(errors="replace")[-4000:],
               "stderr": r.stderr.decode(errors="replace")[-4000:],
               "exit_code": r.returncode}
        return ("ok" if r.returncode == 0 else "failed"), out
    if cmd:
        r = subprocess.run(cmd, shell=True, capture_output=True, timeout=3600)
        out = {"stdout": r.stdout.decode(errors="replace")[-4000:],
               "stderr": r.stderr.decode(errors="replace")[-4000:],
               "exit_code": r.returncode}
        return ("ok" if r.returncode == 0 else "failed"), out
    # no command given — nothing to do
    return "ok", {"note": "no spec.command; treated as no-op"}


def run_worker(cfg, poll=30.0, heartbeat=60.0, once=False, dry_run=False):
    stop = {"flag": False}

    def _sig(_n, _f):
        stop["flag"] = True
    signal.signal(signal.SIGTERM, _sig)
    signal.signal(signal.SIGINT, _sig)

    me = call(cfg, "GET", "/api/agents/me", _exit=False)
    print(f"[mesh worker] {me['name']} role={me['role']} "
          f"poll={poll}s heartbeat={heartbeat}s dry_run={dry_run}", flush=True)
    if me["role"] == "observer":
        print("[mesh worker] WARNING: role is 'observer' — cannot pull work. "
              "Ask the admin to assign a worker+ role.", flush=True)

    last_hb = 0.0
    while not stop["flag"]:
        now = time.time()
        try:
            # presence heartbeat (keep < 90s so we stay 'online')
            if now - last_hb >= heartbeat:
                call(cfg, "POST", "/api/agents/checkin", {}, _exit=False)
                last_hb = now
            # try to claim a task
            d = call(cfg, "GET", "/api/work/pull", _exit=False)
            task = d.get("task")
            if not task:
                if once:
                    print("[mesh worker] no task; exiting (--once)", flush=True)
                    break
                _sleep(poll, stop)
                continue
            tid = task["id"]
            print(f"[mesh worker] claimed {tid}: {task['title']!r}", flush=True)
            try:
                call(cfg, "POST", f"/api/tasks/{tid}/start", {}, _exit=False)
                call(cfg, "POST", f"/api/tasks/{tid}/progress",
                     {"pct": 5, "note": "started"}, _exit=False)
                if dry_run:
                    status, output = "ok", {"dry_run": True,
                                             "spec": task.get("spec")}
                else:
                    status, output = execute_task(cfg, task)
                call(cfg, "POST", f"/api/tasks/{tid}/result",
                     {"status": status, "output": output}, _exit=False)
                print(f"[mesh worker] {tid} -> {status}", flush=True)
            except Exception as e:
                try:
                    call(cfg, "POST", f"/api/tasks/{tid}/result",
                         {"status": "failed", "error": str(e)}, _exit=False)
                except Exception:
                    pass
                print(f"[mesh worker] {tid} FAILED: {e}", flush=True)
            if once:
                break
        except Exception as e:
            # orchestrator unreachable etc. — back off and retry
            print(f"[mesh worker] error: {e}; retrying in {poll}s", flush=True)
            if once:
                break
            _sleep(poll, stop)
    print("[mesh worker] stopped", flush=True)


def _sleep(seconds, stop):
    end = time.time() + seconds
    while not stop["flag"] and time.time() < end:
        time.sleep(min(0.5, max(0.0, end - time.time())))


if __name__ == "__main__":
    main()
